    <!-- About screen. -->
    <string name="settings_about_button_label">Acerca de Sheltr</string>
    <string name="about_title">Acerca de Sheltr</string>
    <string name="about_description">Sheltr es una guía gratuita y sin fines de lucro para prepararse y responder ante desastres. Responde solo con documentos oficiales aprobados y muestra la fuente de cada respuesta.</string>
    <string name="about_disclaimer_title">No es un sistema oficial de alertas</string>
    <string name="about_disclaimer">Sheltr es un proyecto independiente. No es un servicio oficial de ningún gobierno ni organismo y no envía alertas. En una emergencia, siga las instrucciones de las autoridades locales.</string>
    <string name="about_privacy_title">Privacidad</string>
    <string name="about_privacy">Sheltr no tiene cuentas, ni analíticas, ni rastreo. Sus búsquedas y ajustes permanecen en su dispositivo. La aplicación no usa su ubicación. Su única solicitud de red descarga orientación actualizada, y la aplicación comprueba la firma digital de ese contenido antes de usarlo.</string>
    <string name="about_sources_title">Fuentes y licencias</string>
    <string name="about_sources_intro">Cada respuesta proviene de uno de estos documentos. Cada uno conserva su propia licencia.</string>
