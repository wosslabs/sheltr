    <!-- About screen. -->
    <string name="settings_about_button_label">À propos de Sheltr</string>
    <string name="about_title">À propos de Sheltr</string>
    <string name="about_description">Sheltr est un guide gratuit et à but non lucratif pour se préparer aux catastrophes et y réagir. Il répond uniquement à partir de documents officiels approuvés et indique la source de chaque réponse.</string>
    <string name="about_disclaimer_title">Pas un système d\'alerte officiel</string>
    <string name="about_disclaimer">Sheltr est un projet indépendant. Ce n\'est pas un service officiel d\'un gouvernement ou d\'un organisme et il n\'envoie pas d\'alertes. En cas d\'urgence, suivez les consignes de vos autorités locales.</string>
    <string name="about_privacy_title">Confidentialité</string>
    <string name="about_privacy">Sheltr n\'a ni comptes, ni outils d\'analyse, ni suivi. Vos recherches et vos réglages restent sur votre appareil. L\'application n\'utilise pas votre position. Sa seule requête réseau télécharge des conseils à jour, et l\'application vérifie la signature numérique de ce contenu avant de l\'utiliser.</string>
    <string name="about_sources_title">Sources et licences</string>
    <string name="about_sources_intro">Chaque réponse provient de l\'un de ces documents. Chacun conserve sa propre licence.</string>
    <string name="about_sources_empty">Aucun contenu n\'est encore installé.</string>
