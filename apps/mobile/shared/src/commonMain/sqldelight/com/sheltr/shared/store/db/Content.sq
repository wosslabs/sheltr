-- On-device content store. One database file holds one complete bundle; an update builds a new file
-- and replaces the active one (see ContentUpdater), so rows are never edited in place.

CREATE TABLE documents (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    agency TEXT NOT NULL,
    published_date TEXT NOT NULL,
    licence TEXT NOT NULL,
    country TEXT,
    source_uri TEXT NOT NULL,
    source_type TEXT NOT NULL,
    checksum TEXT NOT NULL,
    file_checksum TEXT NOT NULL
);

CREATE TABLE chunks (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES documents(id),
    content TEXT NOT NULL,
    page_number INTEGER,
    position INTEGER NOT NULL
);

CREATE INDEX chunks_document_id ON chunks(document_id, position);

-- Hazards a document covers (BundleDocument.hazards, DisasterType names). Used by the retrieval hazard boost.
CREATE TABLE document_hazards (
    document_id TEXT NOT NULL REFERENCES documents(id),
    hazard TEXT NOT NULL,
    PRIMARY KEY (document_id, hazard)
);

-- Keyword index over chunks.content. Kept in sync by the triggers below.
CREATE VIRTUAL TABLE chunks_fts USING fts5(
    chunk_id UNINDEXED,
    content
);

CREATE TRIGGER chunks_fts_insert AFTER INSERT ON chunks BEGIN
    INSERT INTO chunks_fts(chunk_id, content) VALUES (new.id, new.content);
END;

CREATE TRIGGER chunks_fts_delete AFTER DELETE ON chunks BEGIN
    DELETE FROM chunks_fts WHERE chunk_id = old.id;
END;

-- The bundle version of the content in this file. Exactly one row (id = 1).
-- last_sync_epoch_seconds: UTC time of the last sync that ended Updated or UpToDate (SyncEngine), null until then.
-- It is written to the active file after an install, so a new file starts with null and is set right after the swap.
CREATE TABLE schema_version (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    bundle_version TEXT NOT NULL,
    format_version INTEGER NOT NULL,
    last_sync_epoch_seconds INTEGER
);

insertDocument:
INSERT INTO documents(id, title, agency, published_date, licence, country, source_uri, source_type, checksum, file_checksum)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertDocumentHazard:
INSERT INTO document_hazards(document_id, hazard) VALUES (?, ?);

insertChunk:
INSERT INTO chunks(id, document_id, content, page_number, position)
VALUES (?, ?, ?, ?, ?);

setBundleVersion:
INSERT OR REPLACE INTO schema_version(id, bundle_version, format_version) VALUES (1, ?, ?);

bundleVersion:
SELECT bundle_version FROM schema_version WHERE id = 1;

setLastSync:
UPDATE schema_version SET last_sync_epoch_seconds = ? WHERE id = 1;

lastSync:
SELECT last_sync_epoch_seconds FROM schema_version WHERE id = 1;

countDocuments:
SELECT count(*) FROM documents;

countChunks:
SELECT count(*) FROM chunks;

countDocumentHazards:
SELECT count(*) FROM document_hazards;

countIndexedChunks:
SELECT count(*) FROM chunks_fts;

documentById:
SELECT * FROM documents WHERE id = ?;

hazardsForDocument:
SELECT hazard FROM document_hazards WHERE document_id = ? ORDER BY hazard;

chunksForDocument:
SELECT * FROM chunks WHERE document_id = ? ORDER BY position;

-- match is an FTS5 query expression; StoreReader builds it from user text so the user cannot inject syntax.
-- Lower score is a better match (FTS5 bm25).
search:
SELECT chunks.id, chunks.document_id, chunks.content, chunks.page_number, chunks.position, bm25(chunks_fts) AS score
FROM chunks_fts
JOIN chunks ON chunks.id = chunks_fts.chunk_id
WHERE chunks_fts MATCH :match
ORDER BY score
LIMIT :limit;
